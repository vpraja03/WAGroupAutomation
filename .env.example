# WhatsApp Cloud API
WHATSAPP_TOKEN=your_permanent_or_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v21.0

# Approved Template Library name for group invite links (utility)
WHATSAPP_INVITE_TEMPLATE_NAME=group_invite_link
WHATSAPP_INVITE_TEMPLATE_LANGUAGE=en

# Safety: keep true until you are ready to hit Graph API
DRY_RUN=true

# Default country for numbers without a +country code
DEFAULT_REGION=IN
